---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { bothPaths, t, type Lang } from '../i18n/utils';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description?: string;
  // Une seule prop, pas un système : la 404 est la seule page hors index.
  // À `false`, elle retire la canonique et les trois hreflang, et ajoute
  // `<meta name="robots" content="noindex">` (correction B).
  indexable?: boolean;
}

const { title, description, indexable = true } = Astro.props as Props;
const lang = (Astro.currentLocale ?? 'fr') as Lang;
const s = t(lang);

const { frPath, enPath } = bothPaths(Astro.url.pathname);
const self = lang === 'en' ? enPath : frPath;

/* ====== */
// Personne unique, identique sur les huit pages : un nom et une adresse ne
// se traduisent pas. Pas de numéro de téléphone : il n'est jamais en clair
// dans le HTML servi (SiteFooter.astro le décode au clic), et l'y mettre
// défairait cette protection.
//
// `sameAs` porte le profil LinkedIn, qui existe désormais et figure sur le CV
// maître. C'est le seul profil : le compte GitHub n'expose qu'un site
// statique, donc l'y déclarer n'ajouterait aucun signal. La règle inchangée
// reste qu'on ne déclare que ce qui existe.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Lionel Ratovo',
  jobTitle: 'Développeur full-stack Java, consultant technico-fonctionnel',
  email: 'mailto:lionelratovo@gmail.com',
  sameAs: ['https://www.linkedin.com/in/lionel-ratovo-98a79525a'],
  address: { '@type': 'PostalAddress', addressLocality: 'Antananarivo', addressCountry: 'MG' },
  knowsLanguage: ['mg', 'fr', 'en'],
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: "Université Côte d'Azur" },
    { '@type': 'CollegeOrUniversity', name: 'IT University' },
  ],
};
---

<!doctype html>
<!-- data-theme is hardcoded: without JS the site is light, and the token block
     is never duplicated into a prefers-color-scheme copy that can drift. -->
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Le seul en-tête de sécurité que GitHub Pages laisse poser depuis le
         document : `<meta name="referrer">` est lu par les navigateurs, là où
         X-Frame-Options, X-Content-Type-Options et Permissions-Policy n'ont
         pas d'équivalent en balise et resteront hors de portée tant que le
         site est servi par Pages. La CSP, elle, est écrite par Astro
         (security.csp dans astro.config.mjs). -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <!-- Rendues par scripts/icons.mjs ; ne pas les retoucher à la main. Le
         .ico d'abord, pour les navigateurs qui ne lisent que lui. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {description && <meta name="description" content={description} />}
    {
      indexable ? (
        <>
          <link rel="canonical" href={new URL(self, Astro.site)} />
          <link rel="alternate" hreflang="fr" href={new URL(frPath, Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
          {/* x-default vise le français : c'est la locale par défaut du site, et
              c'est elle qui répond sur les URL sans préfixe. */}
          <link rel="alternate" hreflang="x-default" href={new URL(frPath, Astro.site)} />
        </>
      ) : (
        <meta name="robots" content="noindex" />
      )
    }
    <!-- The h1 carries the LCP: only Bricolage is preloaded so it does not
         contend for bandwidth with the two families that do not gate paint. -->
    <link rel="preload" href="/fonts/Bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
    <!-- Blocking: sets the theme before first paint, so there is no flash. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {}
        var sys = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        var d = document.documentElement;
        d.dataset.theme = stored === "light" || stored === "dark" ? stored : sys;
        d.dataset.themePref = stored || "system";
        // Posée avant le premier rendu : .rv et .stagger ne se cachent que pour
        // un navigateur qui va effectivement les révéler (motion.css, tâche 11).
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("js-motion");
      })();
    </script>
  </head>
  <body>
    <div id="chain"><i></i></div>
    <a class="skip" href="#main">{s.skip}</a>
    <div class="grid-bg"></div>
    <div id="grain"></div>
    <SiteHeader lang={lang} />
    <slot />
    <SiteFooter lang={lang} />
    <script>
      import "../scripts/theme.ts";
    </script>
    <script>
      import "../scripts/motion.ts";
    </script>
    <script>
      import "../scripts/smooth-scroll.ts";
    </script>
  </body>
</html>
