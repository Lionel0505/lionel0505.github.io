---
import type { Lang } from '../i18n/utils';

// Un seul cas a un schéma, et c'est volontaire.
//
// Le schéma SIF a été redessiné d'après le schéma manuscrit de Lionel
// [F2] [F3] [F4] : la source existe, elle est de sa main, elle fait autorité.
//
// Pour `data` (GSK · Cartier) et `web` (Mercedes-Benz), cette source n'existe
// pas. Il n'y a ni schéma d'architecture de Lionel, ni description de la
// topologie des systèmes de ces clients : les deux cas tiennent en quelques
// phrases de faits. Dessiner une architecture à partir de ça reviendrait à
// inventer des affirmations techniques sur les systèmes de clients réels, ce
// que la contrainte de contenu interdit. Ces deux schémas ne sont donc pas
// « à venir » : ils sont absents faute de source, et le resteront tant que
// Lionel n'en aura pas fourni une.
//
// Le composant ne rend rien pour `data` et `web`. Les mises en page qui
// l'appellent ne réservent pas de place pour lui : CaseCard n'existe que pour
// le cas majeur, et dans Case.astro le schéma est un bloc dans le flux, pas
// une colonne.
const { slug, lang } = Astro.props as { slug: string; lang: Lang };
const alt =
  lang === 'fr'
    ? "Le portail SIGFU est une application distincte, en Angular, NestJS et sa propre base PostgreSQL ; il lit le SIF en lecture seule via ses API. Le SIF réunit une interface ExtJS, une API Java, un moteur de règles Drools et une base PostgreSQL de neuf schémas, qui lit et écrit dans les bases d'autres services de l'État."
    : 'The SIGFU portal is a separate application, built on Angular, NestJS and its own PostgreSQL database; it reads the SIF read-only through its APIs. The SIF itself brings together an ExtJS interface, a Java API, a Drools rules engine and a nine-schema PostgreSQL database, which both reads from and writes to the databases of other State services.';
---

{
  slug === 'sif' && (
    <div class="diagram">
      <svg viewBox="0 0 300 226" role="img" aria-label={alt}>
        <rect class="dg-frame" x="4" y="4" width="200" height="60" rx="3" />
        <text class="dg-lbl" x="11" y="17">Portail SIGFU · public</text>
        <rect class="dg-node" x="11" y="24" width="56" height="32" rx="3" />
        <text class="dg-t" x="19" y="44">Angular</text>
        <rect class="dg-node" x="73" y="24" width="56" height="32" rx="3" />
        <text class="dg-t" x="82" y="44">Nest JS</text>
        <rect class="dg-node" x="135" y="24" width="62" height="32" rx="3" />
        <text class="dg-t" x="143" y="44">Postgres</text>
        <path class="dg-l" d="M67 40 h6 M129 40 h6" />

        <path class="dg-l" d="M101 96 V64" style="stroke:var(--or)" />
        <path class="dg-l" d="M97 70 l4 -6 l4 6" style="stroke:var(--or)" />
        <text class="dg-t s" x="110" y="76" style="fill:var(--or-t)">lecture seule</text>
        <text class="dg-t s" x="110" y="86">via les API du SIF</text>

        <rect class="dg-frame" x="4" y="96" width="292" height="68" rx="3" style="stroke:var(--or)" />
        <text class="dg-lbl" x="11" y="109" style="fill:var(--or-t)">SIF</text>
        <rect class="dg-node" x="11" y="116" width="56" height="40" rx="3" />
        <text class="dg-t" x="19" y="140">Ext JS</text>
        <rect class="dg-node" x="73" y="116" width="52" height="40" rx="3" />
        <text class="dg-t" x="81" y="140">API Java</text>
        <rect
          class="dg-node"
          x="131"
          y="116"
          width="56"
          height="40"
          rx="3"
          style="stroke:var(--or);stroke-width:1.6;fill:color-mix(in oklab,var(--or) 14%,transparent)"
        />
        <text class="dg-t" x="139" y="134" style="fill:var(--tx)">Drools</text>
        <text class="dg-t s" x="139" y="146" style="fill:var(--tx)">métier</text>
        <rect
          class="dg-node"
          x="193"
          y="116"
          width="94"
          height="40"
          rx="3"
          style="stroke:var(--tl-t);stroke-width:1.6;fill:color-mix(in oklab,var(--tl) 12%,transparent)"
        />
        <text class="dg-t" x="201" y="130" style="fill:var(--tx)">Postgres</text>
        <text class="dg-t s" x="201" y="141" style="fill:var(--tx)">9 schémas</text>
        <text class="dg-t s" x="201" y="151" style="fill:var(--tx)">innola · 150 t.</text>
        <path class="dg-l" d="M67 136 h6 M125 136 h6 M187 136 h6" />

        <path class="dg-l" d="M212 164 V190" style="stroke:var(--tl-t)" />
        <path class="dg-l" d="M208 170 l4 -6 l4 6" style="stroke:var(--tl-t)" />
        <text class="dg-t s" x="150" y="180" style="fill:var(--tl-t)">lecture</text>
        <path class="dg-l" d="M244 164 V190" style="stroke:var(--tl-t)" />
        <path class="dg-l" d="M240 184 l4 6 l4 -6" style="stroke:var(--tl-t)" />
        <text class="dg-t s" x="252" y="180" style="fill:var(--tl-t)">écriture</text>

        <rect class="dg-frame" x="140" y="190" width="156" height="32" rx="3" />
        <text class="dg-lbl" x="148" y="203">Autres services de l'État</text>
        <text class="dg-t s" x="148" y="215">BDD</text>
      </svg>
    </div>
  )
}

<style>
  /* Toutes les couleurs d'accent du SVG passent par `style="stroke:…"` et non
     par un attribut de présentation `stroke="…"` : un attribut de présentation
     perd contre la règle de classe ci-dessous, et l'accent disparaît.

     Les ratios notés sont mesurés sur la surface réelle de composition, dans
     les deux thèmes (clair / sombre), aplats color-mix compris.

     Trois écarts par rapport à la maquette, tous pour cause de contraste :
       - .dg-frame passe de --bd2 (1,75 / 2,04 sur --bg2) à --tx2 (4,95 / 4,87).
         Les cadres pointillés groupent les boîtes en systèmes : ils portent du
         sens et doivent tenir 3:1.
       - le cadre SIF perd son aplat à 7 % d'--or. Il faisait tomber le libellé
         « SIF » de 4,90/4,54 à 4,52/4,18, en échec en sombre, et il s'empilait
         sous les deux nœuds teintés en dégradant leur texte aussi. Sans lui, le
         libellé pose sur --bg2 : 4,90 / 4,54.
       - les textes des deux nœuds teintés passent en --tx. Sur le lavis à 14 %
         d'--or, --or-t donnait 3,87 en sombre et --tx2 4,15 ; sur le lavis à
         12 % de --tl, --tx2 donnait 3,94. --tx donne 10,74/10,38 et 11,39/9,86.
         Le nœud reste l'accent par son trait et son aplat, ce qui est leur rôle.
     Et un quatrième, même cause : tout ce qui était tracé en --tl (les quatre
     traits lecture/écriture, le trait du nœud Postgres) passe en --tl-t. --tl
     sur --bg2 ne fait que 2,61:1 en clair, sous les 3:1 d'un graphique porteur
     de sens ; --tl-t donne 5,08 / 6,17. Le trait de la liaison lecture seule
     reste en --or (3,64 / 4,15, au-dessus de 3:1). */
  .diagram {
    border: 1px solid var(--bd);
    border-radius: 3px;
    background: var(--bg2);
    padding: 1.1rem;
  }
  .diagram svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .dg-node {
    fill: var(--bg);
    stroke: var(--tx2);
    stroke-width: 1.1;
  }
  .dg-frame {
    fill: none;
    stroke: var(--tx2);
    stroke-width: 1.1;
    stroke-dasharray: 4 3;
  }
  .dg-lbl {
    font-family: var(--ffm);
    font-size: 6.6px;
    letter-spacing: 0.1em;
    fill: var(--tx2);
    text-transform: uppercase;
    font-weight: 700;
  }
  .dg-t {
    font-family: var(--ffm);
    font-size: 7.4px;
    letter-spacing: 0.05em;
    fill: var(--tx);
    text-transform: uppercase;
  }
  .dg-t.s {
    font-size: 6.2px;
    fill: var(--tx2);
  }
  /* Aucun stroke-dasharray ni stroke-dashoffset ici : le tracé animé des
     liaisons appartient à la tâche 11. Sans la timeline qui les remonte, un
     état de repos caché rendrait toutes les liaisons invisibles pour tout le
     monde. L'état de repos d'un élément est son état visible. */
  .dg-l {
    stroke: var(--tx2);
    stroke-width: 1;
    fill: none;
  }
</style>
