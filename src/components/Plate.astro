---
import { buildPlate, fitLabel, HEX } from '../lib/plate.mjs';
import { t, type Lang } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const pts = (P: [number, number][]) =>
  P.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const parcels = buildPlate().map((p) => {
  const l = s.plate.parcels[p.id as keyof typeof s.plate.parcels];
  return { ...p, ...l, ...fitLabel(p.poly, p.cx, p.cy, l.nom, l.sub) };
});
---

<div class="plate">
  <svg viewBox="-16 -18 632 556" role="img" aria-label={s.plate.alt}>
    {/* Etat au repos = etat VISIBLE. La couche de mouvement (tache 11) part
        de la et cache pour reveler, a l'interieur de son bloc garde par
        prefers-reduced-motion et @supports. Coder opacity="0" ici rendrait
        la fleche de nord et « AIRE ∝ DUREE » invisibles sans JavaScript, or
        c'est cette mention qui explique toute la planche. */}
    <g class="tick" id="ticks">
      <path d="M-10 8 L-10 -10 L8 -10"></path><path d="M592 -10 L610 -10 L610 8"></path>
      <path d="M610 512 L610 530 L592 530"></path><path d="M8 530 L-10 530 L-10 512"></path>
    </g>
    <g id="washes">
      {
        parcels.map((p) => (
          <g class="pgroup" id={p.id === 'free' ? 'free' : undefined}>
            <polygon
              class="parcel"
              points={pts(p.poly as [number, number][])}
              fill={`var(--${p.role})`}
              data-op={p.op}
              style={`fill-opacity:${p.op}`}
            />
            {p.id === 'free' && <polygon class="free-ring" points={pts(p.poly as [number, number][])} />}
            <g class={p.id === 'free' ? 'free-main' : undefined}>
              <text
                class="plbl"
                x={p.cx}
                y={p.tight ? p.cy + p.fs * 0.34 : p.cy - p.fs * 0.32}
                text-anchor="middle"
                style={`font-size:${p.fs.toFixed(1)}px`}
                data-lbl
              >
                {p.nom}
              </text>
              {!p.tight && (
                <text
                  class="plbl sub"
                  x={p.cx}
                  y={p.cy + p.fs * 0.32 + p.ss + 2}
                  text-anchor="middle"
                  style={`font-size:${p.ss.toFixed(1)}px`}
                  data-lbl
                >
                  {p.sub}
                </text>
              )}
            </g>
            {p.id === 'free' && (
              <text
                class="plbl free-hint"
                x={p.cx}
                y={p.cy + 3}
                text-anchor="middle"
                fill="var(--or-t)"
                style={`font-size:${p.fs.toFixed(1)}px`}
              >
                {s.plate.hint}
              </text>
            )}
          </g>
        ))
      }
    </g>
    <g id="lines">
      {/* Le contour de chaque parcelle fait le trait de division. Les arêtes
          partagées sont tracées deux fois : sans conséquence visuelle, et ça
          évite de tenir un graphe d'adjacence pour rien. */}
      {parcels.map((p) => <path class="line div" d={`M${pts(p.poly as [number, number][]).replaceAll(' ', ' L')} Z`} />)}
      <path class="line outer" d={`M${pts(HEX as [number, number][]).replaceAll(' ', ' L')} Z`}></path>
      <path
        class="line outer"
        stroke="var(--or)"
        d={`M${pts((parcels.find((p) => p.id === 'sif') as (typeof parcels)[number]).poly as [number, number][]).replaceAll(' ', ' L')} Z`}
      ></path>
    </g>
    <g id="annos">
      <path class="tick" d="M34,518 v-26 l-6 9 m6-9 l6 9"></path>
      <text class="anno" x="46" y="515">N</text>
      <text class="anno" x="82" y="515">{s.plate.scale}</text>
      <text class="anno" x="366" y="515">{s.plate.total}</text>
      <text class="anno" x="452" y="-4">{s.plate.sheet}</text>
    </g>
  </svg>
  <ul class="plate-key">
    {s.plate.keys.map(([k, v]) => (
      <li>
        <i style={`background:var(--${k})`}></i>{v}
      </li>
    ))}
    <li><i class="free-key"></i>{s.plate.keyFree}</li>
  </ul>
</div>

<style>
  .plate svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .parcel {
    /* Resting wash comes from the inline fill-opacity (its mission's `op`),
       set directly in the markup: no JS ships to apply it, so the wash must
       already be the visible, settled state. Hover boosts it, `!important`
       beating the inline style. */
    transition: fill-opacity 0.45s var(--ease);
  }
  .pgroup {
    cursor: crosshair;
  }
  .pgroup:hover .parcel {
    fill-opacity: 0.9 !important;
  }
  .pgroup:hover .plbl {
    font-weight: 700;
  }
  .free-ring {
    fill: none;
    stroke: var(--tx2);
    stroke-width: 2.2;
    stroke-dasharray: 9 7;
    opacity: 0;
    transition: stroke 0.3s var(--ease);
  }
  #free:hover .free-ring {
    stroke: var(--or);
    opacity: 1;
  }
  .pgroup .free-hint {
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .pgroup:hover .free-hint {
    opacity: 1;
  }
  .pgroup:hover .free-main {
    opacity: 0;
  }
  .line {
    fill: none;
    stroke: var(--tx);
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .line.outer {
    stroke-width: 2.4;
  }
  .line.div {
    stroke: var(--tx2);
    stroke-width: 1.1;
  }
  .plbl {
    /* The reference's entrance state (opacity:0, revealed by the scroll-in
       JS of the motion layer) is not applicable here: this build ships no
       JS, and the label is the only on-page reading of the career for a
       sighted user, so it starts visible. */
    font-family: var(--ffm);
    font-size: 11px;
    letter-spacing: 0.04em;
    fill: var(--tx);
    text-transform: uppercase;
    font-weight: 600;
    opacity: 1;
  }
  .plbl.sub {
    font-size: 8.6px;
    fill: var(--tx2);
    font-weight: 400;
    letter-spacing: 0.07em;
  }
  .anno {
    font-family: var(--ffm);
    font-size: 8px;
    letter-spacing: 0.11em;
    fill: var(--tx2);
  }
  .tick {
    stroke: var(--tx2);
    stroke-width: 1.1;
    fill: none;
  }

  .plate-key {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.15rem;
  }
  .plate-key li {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    font-family: var(--ffm);
    font-size: 0.6rem;
    letter-spacing: 0.075em;
    text-transform: uppercase;
    color: var(--tx2);
  }
  .plate-key i {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    flex: none;
  }
  .plate-key i.free-key {
    background: transparent;
    border: 1.5px dashed var(--tx2);
  }

  @media (max-width: 767px) {
    .plate {
      margin-inline: calc(var(--gut) * -1);
    } /* full-bleed */
    .plbl.sub {
      display: none;
    } /* dates removed, names kept */
    .plbl {
      font-size: 15px !important;
    } /* écrase le corps calculé */
    .anno,
    #ticks {
      display: none;
    } /* sheet marks are noise here */
  }
</style>
