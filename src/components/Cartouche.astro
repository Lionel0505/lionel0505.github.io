---
import { t, type Lang } from '../i18n/utils';

const { lang } = Astro.props as { lang: Lang };
const s = t(lang);
const fr = lang === 'fr';
// Portée unique : les six cellules valent pour la carrière entière. Les
// chiffres propres au SIF vivent dans son étude de cas (tâche 9), où ils ont
// un contexte — les mélanger ici a été le second remarque de Lionel [F8].
// « 2021 », pas « 5 ans » : novembre 2021 à août 2026 fait quatre ans et neuf
// mois ; une date de départ ne dérive jamais et ne surestime jamais.
const cells = [
  { k: s.cartouche.since, v: '2021', big: true },
  { k: s.cartouche.missions, v: '5', big: true },
  {
    k: s.cartouche.field,
    v: fr ? "Côte d'Ivoire · Maurice · Madagascar" : "Côte d'Ivoire · Mauritius · Madagascar",
  },
  { k: s.cartouche.education, v: 'Master MIAGE · MBDS' },
  {
    k: s.cartouche.languages,
    v: fr ? 'Malagasy · Français · Anglais' : 'Malagasy · French · English',
  },
  {
    k: s.cartouche.availability,
    v: fr ? 'Ouvert aux opportunités' : 'Open to opportunities',
  },
];
---

<div class="cartouche">
  <div class="cart-head">
    <span class="mono">{s.cartouche.label}</span>
    <span class="mono">{s.cartouche.place}</span>
  </div>
  <div class="cart-grid">
    {
      cells.map((cell) => (
        <div class="cell">
          <span class="k mono">{cell.k}</span>
          <span class="v">{cell.big ? <b>{cell.v}</b> : cell.v}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .cartouche {
    border: 1.5px solid var(--tx);
    border-radius: 3px;
    background: var(--bg2);
    overflow: hidden;
  }
  .cart-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-bottom: 1.5px solid var(--tx);
    background: var(--bg3);
  }
  .cart-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
  }
  @media (max-width: 940px) {
    .cart-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .cell {
    padding: 0.95rem 1rem 1.1rem;
    border-right: 1px solid var(--bd);
  }
  .cell:last-child {
    border-right: 0;
  }
  @media (max-width: 940px) {
    .cell {
      border-bottom: 1px solid var(--bd);
    }
    .cell:nth-child(2n) {
      border-right: 0;
    }
  }
  .cell .k {
    display: block;
    margin-bottom: 0.42rem;
    font-size: 0.6rem;
  }
  .cell .v {
    font-size: 0.9rem;
    font-weight: 560;
    line-height: 1.34;
    color: var(--tx);
  }
  .cell .v b {
    font-family: var(--ffd);
    font-size: 1.28rem;
    font-weight: 760;
    letter-spacing: -0.03em;
    color: var(--or-t);
  }
</style>
